{
  "name": "wemake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Realtime collaborative music studio: jam, record and produce with friends in the browser.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@webaudiomodules/sdk": "0.0.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "ws": "8.22.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
